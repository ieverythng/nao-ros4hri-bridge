{
  "schema_version": 1,
  "description": "Deterministic KnowledgeCore scene fixtures for runtime-review questionnaires. These mirror interaction_sim-style facts without requiring manual rqt_human_radar scene setup.",
  "source_notes": [
    "ROS4HRI tutorial: interaction_sim can load a visual SVG scene, and rqt_human_radar publishes facts such as rdf:type, myself sees, person sees, isIn, and isOn to KnowledgeCore.",
    "The SVG is visual only for this validation harness. The semantic source of truth is the KnowledgeCore fact set injected through /kb/revise."
  ],
  "environments": {
    "baseline_table": {
      "description": "Minimal one-table baseline with a cup and book. Use for launch-time smoke validation and fast KB inventory checks.",
      "visual_svg_source": "docs/artifacts/preloaded_environments/baseline_table.svg",
      "statements": [
        "codex_base_table rdf:type Table",
        "codex_base_table dbp:name table",
        "codex_base_table dbp:frameId map",
        "codex_base_table dbp:poseSource semantic_fixture",
        "codex_base_table dbp:poseX 0.80",
        "codex_base_table dbp:poseY 0.00",
        "myself sees codex_base_table",
        "codex_base_cup rdf:type Cup",
        "codex_base_cup dbp:name BASE_CUP",
        "codex_base_cup dbp:color red",
        "codex_base_cup oro:isOn codex_base_table",
        "myself sees codex_base_cup",
        "myself canReach codex_base_cup",
        "codex_base_book rdf:type Book",
        "codex_base_book dbp:name BASE_BOOK",
        "codex_base_book dbp:color blue",
        "codex_base_book oro:isOn codex_base_table",
        "myself sees codex_base_book",
        "myself canReach codex_base_book",
        "myself oro:isAt codex_base_station",
        "codex_base_station rdf:type Place",
        "codex_base_station dbp:name robot_station",
        "codex_base_station dbp:frameId map",
        "codex_base_station dbp:poseSource semantic_fixture",
        "codex_base_station dbp:poseX 0.00",
        "codex_base_station dbp:poseY 0.00"
      ],
      "query_patterns": [
        "codex_base_table ?predicate ?object",
        "codex_base_cup ?predicate ?object",
        "codex_base_book ?predicate ?object",
        "codex_base_station ?predicate ?object"
      ],
      "query_vars": [
        "?predicate",
        "?object"
      ]
    },
