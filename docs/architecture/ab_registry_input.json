      "required_params": [],
      "preconditions": [
        "fresh perception requested"
      ],
      "expected_effects": [
        "refreshed scene evidence",
        "typed scan result payload"
      ],
      "observable_success": [
        "target_found",
        "evidence.people",
        "evidence.objects"
      ],
      "failure_modes": [
        "no_person",
        "objects_only",
        "backend_unavailable",
        "unexpected_payload"
      ],
      "planner_guidance": [
        "use scan for fresh perception requests",
        "do not decompose scan into head motion unless debugging scan itself",
        "prioritize people evidence for person-target scans"
      ],
      "robot_adapter_mapping": "nao_orchestrator.scan",
      "result_schema": {
        "required": [
          "skill",
          "status",
          "summary_text"
        ],
        "optional": [
          "target",
          "target_kind",
          "target_found",
          "evidence",
          "failure",
          "metadata"
        ]
      },
